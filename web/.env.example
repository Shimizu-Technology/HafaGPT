# HåfaGPT Frontend Environment Variables
# Copy this file to .env.local and fill in your values

# ============================================
# BACKEND API (Required)
# ============================================
# Local development
VITE_API_URL=http://localhost:8000

# For production (Netlify sets this automatically)
# VITE_API_URL=https://hafagpt-api.onrender.com

# ============================================
# AUTHENTICATION (Required)
# ============================================
# Clerk publishable key - get from dashboard.clerk.com → API Keys
# Use the PUBLISHABLE key (starts with pk_test_ or pk_live_)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# ============================================
# ANALYTICS (Optional)
# ============================================
# PostHog - public project settings used for usage analytics. Leave blank to
# disable locally; never copy private PostHog personal/project API keys here.
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=
