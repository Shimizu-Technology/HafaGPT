{
  "_description": "Custom pronunciation dictionary for Chamorro words based on Dr. Sandra Chung's orthography guide.",
  "_sources": [
    "Two Chamorro Orthographies - Dr. Sandra Chung (March 2019)",
    "Key sounds: Y=/dz/, CH=/ts/, Å=/aw/, Ñ=/ny/, NG=single sound like 'sing'"
  ],
  "_notes": [
    "Y is pronounced like 'dz' (NOT English 'y') - e.g., Hayi = Hah-dzee",
    "CH is pronounced like 'ts' (NOT English 'ch') - e.g., Chocho = Tso-tso",
    "Å is pronounced like 'aw' in 'saw'",
    "NG is a single sound, not 'n' + 'g' separately",
    "Glottal stop (') is a brief pause"
  ],
