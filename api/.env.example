# HåfaGPT Backend Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# DATABASE (Required)
# ============================================
# Prefer an isolated local database for development. PostgreSQL must have pgvector.
DATABASE_URL=postgresql://localhost/chamorro_rag

# ============================================
# AI SERVICES (Required)
# ============================================
# OpenAI - used for cloud embeddings
OPENAI_API_KEY=sk-...

# OpenRouter - tutor, flashcards, practice, summaries and private benchmarks
OPENROUTER_API_KEY=sk-or-...

# ============================================
# AUTHENTICATION (Required)
# ============================================
# Clerk - get from dashboard.clerk.com → API Keys
CLERK_SECRET_KEY=sk_test_...
# Required in production for /api/webhooks/clerk signature verification
CLERK_WEBHOOK_SECRET=whsec_...
# Exact browser origins allowed to mint Clerk session tokens for this API.
CLERK_AUTHORIZED_PARTIES=http://localhost:5173,http://127.0.0.1:5173
# Exact Frontend API issuer from Clerk's API Keys page (recommended).
CLERK_ISSUER=https://your-instance.clerk.accounts.dev

# ============================================
# AWS S3 - File Uploads (Optional for local dev)
# ============================================
# Ask team lead for credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=hafagpt-uploads
# Separate private bucket for family chat attachments. New uploads fail closed
# (current-request processing only) when this is unset; never reuse a public audio bucket.
AWS_PRIVATE_UPLOADS_BUCKET=hafagpt-private-uploads
AWS_REGION=us-west-2

# ============================================
# MODEL CONFIGURATION (Optional - has defaults)
# ============================================
# Tutor/photos remain on the established route. Both feature overrides are optional.
# Roll either feature back to gpt-5.6-luna without changing tutor/photo routing.
CHAT_MODEL=gpt-5.6-luna
FLASHCARD_MODEL=gpt-6-luna
PRACTICE_MODEL=gpt-6.1-terra
# Candidate photo format/extraction settings are disabled until photo-language
# acceptance. Local QA may explicitly opt in; see evaluation/PHOTO_TRANSLATION_ACCEPTANCE.md.
HAFAGPT_PHOTO_TRANSLATION_STREAMING_ENABLED=false
# Production defaults to the legacy collection. Evaluation-only collections are
# rejected unless code explicitly declares the model_evaluation purpose.
# Pair this OpenAI collection with EMBEDDING_MODE=openai below.
# The legacy chamorro_grammar collection uses MiniLM and cannot be mixed with it.
RAG_COLLECTION_NAME=hafagpt_governed_openai_v3
# Reject vector candidates above this cosine distance. The default is 0.75.
RAG_MAX_VECTOR_DISTANCE=0.75

# Embedding mode: openai (recommended) or local
EMBEDDING_MODE=openai

# Optional web-search grounding
BRAVE_API_KEY=

# Optional text-to-speech provider
ELEVENLABS_API_KEY=
# One voice shared by live, batch, and admin generation.
ELEVENLABS_MODEL=eleven_multilingual_v2
# Live speech stays on v2 until the pronunciation pilot passes.
ELEVENLABS_LIVE_MODEL=eleven_multilingual_v2
# The pronunciation studio explicitly requests eleven_v4.
ELEVENLABS_VOICE_ID=
TTS_PROVIDER=elevenlabs

# ============================================
# SECURITY / RATE LIMITING
# ============================================
# Comma-separated browser origins. Never use "*" in production.
# Capacitor mobile app origins are appended automatically by the API.
# Example: https://hafagpt.com,https://www.hafagpt.com,https://hafagpt.netlify.app
ALLOWED_ORIGINS=

# Public chat rate limiting
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60

# Public TTS rate limiting
TTS_RATE_LIMIT_REQUESTS=20
TTS_RATE_LIMIT_WINDOW=60

# Optional protected evaluation endpoints (/api/eval/*).
# Set EVAL_API_KEY and send X-Eval-API-Key, or ENABLE_EVAL_ENDPOINTS=true for local-only testing.
EVAL_API_KEY=
ENABLE_EVAL_ENDPOINTS=false

# Rights-gated copied story content. Keep disabled unless a written reuse
# agreement is recorded in the source registry and the matching internal
# permission identifier is supplied.
LENGGUAHITA_STORIES_ENABLED=false
LENGGUAHITA_STORIES_PERMISSION_ID=

# ============================================
# ERROR MONITORING (Optional)
# ============================================
# Sentry DSN for error tracking and provider-failure alerts (production only).
# Copy it from Sentry > Project Settings > Client Keys (DSN). It must look like
# https://<public_key>@<host>/<project_id>. A malformed value (for example a
# project URL without the key, which Sentry reports as "Missing public key")
# disables Sentry at startup with one warning instead of breaking it.
# SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0

# AI provider outage alerts (all optional; values are per API worker process).
# A credit/402 failure alerts once per cooldown; other provider failures alert
# once per cooldown after THRESHOLD failures inside WINDOW seconds.
# PROVIDER_ALERT_COOLDOWN_SECONDS=1800
# PROVIDER_ALERT_BURST_THRESHOLD=5
# PROVIDER_ALERT_BURST_WINDOW_SECONDS=300

# ============================================
# DEVELOPMENT ONLY
# ============================================
# Set to true to enable debug logging
# DEBUG=true
# FREE_PROMO_PERIOD=false
