# HåfaGPT Backend Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# DATABASE (Required)
# ============================================
# Get from team lead or Render dashboard
DATABASE_URL=postgresql://user:password@host:5432/database_name

# ============================================
# AI SERVICES (Required)
# ============================================
# OpenAI - for embeddings (get from platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# OpenRouter - for DeepSeek chat model (get from openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-...

# ============================================
# AUTHENTICATION (Required)
# ============================================
# Clerk - get from dashboard.clerk.com → API Keys
CLERK_SECRET_KEY=sk_test_...

# ============================================
# AWS S3 - File Uploads (Optional for local dev)
# ============================================
# Ask team lead for credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=hafagpt-uploads

# ============================================
# MODEL CONFIGURATION (Optional - has defaults)
# ============================================
# Chat model: deepseek-v3, gpt-4o, gpt-4o-mini, claude-sonnet, gemini-2.5-flash
CHAT_MODEL=deepseek-v3

# Embedding mode: openai (recommended) or local
EMBEDDING_MODE=openai

# ============================================
# ERROR MONITORING (Optional)
# ============================================
# Sentry DSN for error tracking (production only)
# SENTRY_DSN=https://...@sentry.io/...

# ============================================
# DEVELOPMENT ONLY
# ============================================
# Set to true to enable debug logging
# DEBUG=true
